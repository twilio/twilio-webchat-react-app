# docker.artifacts.twilio.com (Artifactory's Docker Hub proxy) 401s on the general-001
# queue - it's not Artifactory-enabled (see owl's pipeline for the same restriction on
# its locked-down queue). registry.twilio.com works instead - same pattern other repos'
# pipelines use without any explicit login step (e.g. flex-admin-api's
# registry.twilio.com/library/base-node/22:latest).
FROM registry.twilio.com/library/base-node/14:latest

# This base image is Alpine-based (no apt-get), unlike Docker Hub's node:14.18.1.
RUN apk add --no-cache git

WORKDIR /app

ENV CI=true
ENV LC_ALL=en_GB.UTF-8
